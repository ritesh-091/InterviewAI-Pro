# ==========================================
# INTERVIEWAI PRO CORE ENV CONFIGURATIONS
# ==========================================

# Server execution port
PORT=5000

# Client web hosting origin url
CLIENT_URL=http://localhost:5173

# Vite Dynamic host endpoint target
VITE_API_URL=http://localhost:5000/api

# MongoDB database connection string
MONGODB_URI=mongodb://localhost:27017/interviewai_pro

# JSON Web Token secret keys
JWT_SECRET=super_secret_signing_key_at_least_32_characters_long
JWT_SECRET_REFRESH=super_secret_refresh_signing_key_at_least_32_characters_long

# Redis cache server config (falls back to memory if empty)
REDIS_URL=redis://localhost:6379

# Google Gemini API credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary assets storage configs (revert to local storage if empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay payments gateway coordinates
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend SMTP email coordinates (nodemailer config)
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=re_your_resend_api_key_value

# Code Sandbox execution (Judge0 API credentials)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key_here
